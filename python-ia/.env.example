# --- Base de datos (los mismos valores deben ir en backend/.env) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=menaje_db
DB_USER=postgres
DB_PASSWORD=tu_password

# --- Gemini --- (obtener en https://aistudio.google.com/apikey)
API_GEMINI_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Servidor ---
PYTHON_IA_HOST=127.0.0.1
PYTHON_IA_PORT=8000
# Debe coincidir con IA_SERVICE_TOKEN de backend/.env
IA_SERVICE_TOKEN=
# 'dev' habilita /docs; cualquier otro valor lo deshabilita
IA_ENV=production

# --- Opcionales (valores por defecto en el codigo; descomentar para cambiarlos) ---
# Nivel de log del microservicio: DEBUG registra el contenido de los mensajes.
#LOG_LEVEL=INFO
# Conexiones del pool de PostgreSQL que puede consumir este servicio.
#DB_POOL_MIN=1
#DB_POOL_MAX=5
